<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Versions verified on nuget.org on 2026-11-05 (c001 design.md D2). The .NET 11 packages are
       RC3, matching global.json; the move to GA is a follow-up PR. -->

  <ItemGroup Label="API">
    <!-- A beta on purpose (c001 design.md D2): 8.3.0 maps an anonymous GET /_test_url_cache_
         listing every endpoint, in every environment. 9.0 maps it only when
         FastEndpoints:ExposeTestUrlCache is true; never set it. -->
    <PackageVersion Include="FastEndpoints" Version="9.0.0-beta.7" />
    <!-- Sign-in (c007 design.md D2, D7, D9), versions verified on nuget.org on 2026-11-08. -->
    <!-- The OpenAPI document, written by an explicit export check and never served (D9). FastEndpoints.OpenApi
         builds on Microsoft.AspNetCore.OpenApi. No Microsoft.Extensions.ApiDescription.Server: its export at
         build time starts the app, whose start-up checks refuse the placeholder secrets (c007 bootstrap). -->
    <PackageVersion Include="FastEndpoints.OpenApi" Version="9.0.0-beta.7" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0-rc.3.26522.148" />
    <!-- The login cookie's encryption keys: a blob, encrypted by a Key Vault key (D7). Azure.Identity
         for its credential is listed once, below, with the telemetry exporter (C11). -->
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.5" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.5" />
  </ItemGroup>

  <ItemGroup Label="AppHost">
    <!-- Runs the frontend's Vite dev server as the "web" resource (c003 design.md D11). Matches
         the Aspire.AppHost.Sdk version in RevolutReader.AppHost.csproj. -->
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.4" />
  </ItemGroup>

  <ItemGroup Label="ServiceDefaults">
    <!-- No Microsoft.Extensions.Http.Resilience: outgoing HTTP calls get no default retries
         (c001 design.md D5, ADR-0001-bank-data-access). -->
    <!-- The app's logs and traces go to Application Insights through the in-app exporter, signed
         in with the app's managed identity (c006 design.md D8 b, D10; verified on nuget.org on
         2026-11-08). The exporter needs OpenTelemetry.Extensions.Hosting 1.18.0 or later. -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.10.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- Mvc.Testing is pinned directly: TUnit.AspNetCore is built up to net10.0 and would
         otherwise pull 10.0.14 into the net11.0 test host. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-rc.3.26522.148" />
    <!-- The fake clock every app copy runs on (c007 design.md D6). -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <!-- The telemetry guard collects what the app exports (c004 design.md D5); same version as the other OpenTelemetry packages. -->
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="TUnit" Version="1.80.0" />
    <PackageVersion Include="TUnit.AspNetCore" Version="1.80.0" />
    <!-- The fake bank: a local HTTP server in front of our real Enable Banking client (testing.md § Fake bank, verified 2026-11-06). -->
    <PackageVersion Include="WireMock.Net" Version="2.21.0" />
  </ItemGroup>

  <ItemGroup Label="Tooling (repo-wide via Directory.Build.props)">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
  </ItemGroup>

</Project>
