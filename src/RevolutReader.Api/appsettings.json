{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // A failed sign-in is logged once, as SignInFailed with only its kind (c007 design.md D3). The OpenID Connect
      // handler's own error lines carry exception text and whatever anyone posts to the return address, so they stay off.
      // Lower this briefly (an environment variable on the container app) to look into a hard case.
      "Microsoft.AspNetCore.Authentication.OpenIdConnect": "Critical",
      // The resilience library behind the bank client's retries (c008 design.md D9): its warning for every retry stays; its
      // Information line for every successful attempt goes, or every bank request would add a line to Application Insights.
      "Polly": "Warning",
      // The Azure SDK behind the transaction store (c010 design.md D11): Aspire's tables client forwards every event source
      // of the SDK, each under its own name (Azure.Core, Azure.Identity, Azure.Data.Tables, …), Information for every
      // table request, its answer and every token the app's identity gets; its warnings and errors stay, the rest goes, or
      // every transactions request would add lines to Application Insights. "Azure" covers them all.
      "Azure": "Warning"
    }
  },
  "AllowedHosts": "*",
  // The standard names Azure Monitor and Azure.Identity use, read in ServiceDefaults as OTEL_EXPORTER_OTLP_ENDPOINT is
  // (c006 design.md D8). Empty: nothing is exported to Azure (local runs, tests).
  // Production: environment variable on the container app, from the Application Insights resource (infra) · Local: empty.
  "APPLICATIONINSIGHTS_CONNECTION_STRING": "",
  // Production: environment variable on the container app, the client ID of id-revolutreader-app (infra) · Local: empty.
  "AZURE_CLIENT_ID": "",
  // The bank adapter (c004 design.md D6).
  "EnableBanking": {
    // Production: this value · Local: this value (the sandbox application uses the same API).
    "ApiBaseUrl": "https://api.enablebanking.com",
    // Production: Key Vault, through a Container Apps secret, as EnableBanking__ApplicationId · Local: the AppHost's user-secrets, parameter enablebanking-application-id.
    "ApplicationId": "<secret>",
    // Production: Key Vault, through a Container Apps secret, as EnableBanking__PrivateKey (PEM text) · Local: the AppHost's user-secrets, parameter enablebanking-private-key (the sandbox key file's text).
    "PrivateKey": "<secret>",
    // Production: Key Vault, through a Container Apps secret, as EnableBanking__SessionId · Local: the AppHost's user-secrets, parameter enablebanking-session-id (the Mock ASPSP session).
    "SessionId": "<secret>",
    // Production: Key Vault, through a Container Apps secret, as EnableBanking__AccountId · Local: the AppHost's user-secrets, parameter enablebanking-account-id (the Mock ASPSP account).
    "AccountId": "<secret>",
    // Production: this value · Local: this value. Kept after the check against the real account (Check 2) measured the slowest request at 0.76 s (c004 design.md D4, D7; c008 design.md § Context).
    // The limit for one request with all its retries and the waits between them (c008 design.md D1).
    "RequestTimeout": "00:00:15",
    // Production: this value · Local: this value. The wait before a present user's first retry; later waits double from it,
    // spread at random: the Azure SDK's first wait (c008 design.md D4, D7). The tests set zero: their app copies run on a
    // FakeTimeProvider, which moves only when a test moves it, so a longer wait would never end; a zero wait does not
    // depend on the clock.
    "RetryDelay": "00:00:00.8"
  },
  // Sign-in through Microsoft (c007 design.md D2, D8, D11).
  "SignIn": {
    // Production: this value · Local: this value (Microsoft's service for personal Microsoft accounts).
    "Authority": "https://login.microsoftonline.com/consumers/v2.0",
    // Production: this value · Local: this value (the Entra app registration, docs/operations/entra-id.md; not confidential).
    "ClientId": "7833ec21-abbc-493b-b764-8b74eb3bcaa0",
    // Production: Key Vault, through a Container Apps secret, as SignIn__ClientSecret · Local: the AppHost's user-secrets, parameter signin-client-secret.
    "ClientSecret": "<secret>",
    // Production: Key Vault, through a Container Apps secret, as SignIn__AllowedEmails (comma-separated addresses) · Local: the AppHost's user-secrets, parameter signin-allowed-emails.
    "AllowedEmails": "<secret>"
  },
  // The login cookie's encryption keys (c007 design.md D7): both addresses empty or both set; when set, the app reaches
  // them with its managed identity, whose client ID AZURE_CLIENT_ID holds (set by Bicep, as for telemetry).
  "DataProtection": {
    // Production: set by Bicep (the keys blob in the storage account) · Local: empty, ASP.NET's default key folder.
    "KeysBlobUri": "",
    // Production: set by Bicep (the Key Vault key that encrypts the keys, versionless) · Local: empty, ASP.NET's default key folder.
    "KeyVaultKeyUri": ""
  },
  // Where the settled transactions are kept (c010 design.md D5, D11). Not a secret: in Azure an address, reached with the
  // app's managed identity, whose client ID AZURE_CLIENT_ID holds (as for the login cookie's keys); shared keys stay off.
  "ConnectionStrings": {
    // Production: set by Bicep as ConnectionStrings__tables, the storage account's table endpoint · Local: the AppHost's
    // Azurite, handed over by the AppHost · Tests: the harness's Azurite. Empty here: registering the store refuses an
    // empty one, naming the setting.
    "tables": ""
  },
  // The store of settled transactions (c010 design.md D11).
  "Transactions": {
    // Production: this value, the table Bicep creates · Local: this value · Tests: a table of each app copy's own. 3 to 63
    // letters (A to Z) and digits, starting with a letter: checked at start.
    "TableName": "transactions"
  },
  // Web Push, the notifications the app sends to the devices (c011 design.md D5, D9, D13). Checked at start.
  "Push": {
    // The VAPID public key, the 65-byte P-256 point in base64url (D5): not confidential (every browser gets it), but kept
    // next to its private half so the two always match.
    // Production: Key Vault, as Push--VapidPublicKey, through a Container Apps secret (Bicep, D12), as Push__VapidPublicKey · Local: the AppHost's user-secrets, parameter push-vapid-public-key.
    "VapidPublicKey": "<secret>",
    // The VAPID private key, the 32-byte scalar in base64url (D5).
    // Production: Key Vault, as Push--VapidPrivateKey, through a Container Apps secret (Bicep, D12), as Push__VapidPrivateKey · Local: the AppHost's user-secrets, parameter push-vapid-private-key.
    "VapidPrivateKey": "<secret>",
    // The message endpoint's key, at least 32 random bytes in base64url (D5, D10).
    // Production: Key Vault, as Push--MessageKey, through a Container Apps secret (Bicep, D12), as Push__MessageKey · Local: the AppHost's user-secrets, parameter push-message-key.
    "MessageKey": "<secret>",
    // The token's contact and the base of every page a tap opens (D2, D5): an https address with no path, query or fragment.
    // Production: set by Bicep as Push__Subject, the app's own address (D12) · Local: this value.
    "Subject": "https://localhost",
    // The push services a device may register a push address at (D9): https and a host, or *. and a host suffix. Named,
    // so a test adds one without rewriting the others. From pushpad's known-push-services list (read 2026-11-09).
    // Production: these values · Local: these values · Tests: the fake push service added as Push:Services:FakePushService.
    "Services": {
      "Apple": "https://*.push.apple.com",
      "Google": "https://fcm.googleapis.com",
      "Mozilla": "https://updates.push.services.mozilla.com",
      "Microsoft": "https://*.notify.windows.com"
    },
    // Production: this value · Local: this value. How long one push request waits for its answer, 1 to 60 seconds (D13).
    "RequestTimeout": "00:00:10"
  },
  // The store of the devices registered for pushes (c011 design.md D11), on the same tables connection as the transactions.
  "PushDevices": {
    // Production: this value, the table Bicep creates · Local: this value · Tests: a table of each app copy's own. 3 to 63
    // letters (A to Z) and digits, starting with a letter: checked at start.
    "TableName": "pushdevices"
  }
}
