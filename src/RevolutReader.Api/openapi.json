{
  "openapi": "3.2.0",
  "info": {
    "title": "RevolutReader.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/auth/login": {
      "get": {
        "tags": [
          "Api"
        ],
        "summary": "Starts the sign-in at Microsoft",
        "operationId": "RevolutReaderApiSignInLoginEndpoint",
        "parameters": [
          {
            "name": "anotherAccount",
            "in": "query",
            "description": "Asks Microsoft to show its account picker",
            "schema": {
              "type": [
                "null",
                "boolean"
              ]
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Found"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Api"
        ],
        "summary": "Ends the sign-in on this device",
        "operationId": "RevolutReaderApiSignInLogoutEndpoint",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "Api"
        ],
        "summary": "Who is signed in",
        "operationId": "RevolutReaderApiSignInMeEndpoint",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiSignInMeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiSignInRefusedProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/transactions": {
      "get": {
        "tags": [
          "Api"
        ],
        "summary": "The newest transactions, read at the bank, with the koruna rate",
        "operationId": "RevolutReaderApiAccountNewestTransactionsEndpoint",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiAccountTransactionPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiSignInRefusedProblem"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiAccountBankProblem"
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiAccountBankProblem"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "The app is running",
        "operationId": "RevolutReaderApiHealthHealthEndpoint",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MicrosoftAspNetCoreMvcProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RevolutReaderApiAccountBankProblem": {
        "required": [
          "type"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "description": "Which of the bank's expected failures this is",
            "$ref": "#/components/schemas/RevolutReaderApiAccountBankProblemType"
          }
        },
        "description": "A problem description of one of the bank's expected failures, named by its type"
      },
      "RevolutReaderApiAccountBankProblemType": {
        "enum": [
          "/problems/bank-access-expired",
          "/problems/bank-rate-limited",
          "/problems/bank-unavailable"
        ],
        "type": "string"
      },
      "RevolutReaderApiAccountTransactionKind": {
        "enum": [
          "CardPayment",
          "TopUp",
          "Transfer",
          "CashWithdrawal",
          "Exchange",
          "Refund",
          "Other"
        ],
        "type": "string"
      },
      "RevolutReaderApiAccountTransactionPageResponse": {
        "required": [
          "transactions",
          "olderBefore",
          "czkPerEur",
          "rateDate"
        ],
        "type": "object",
        "properties": {
          "transactions": {
            "description": "The page's transactions, newest day first, in the bank's order within a day",
            "$ref": "#/components/schemas/SystemCollectionsGenericIReadOnlyListOfRevolutReaderApiAccountTransactionResponse"
          },
          "olderBefore": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The day before which older transactions are kept, to ask for the next older page with; null when none are",
                "$ref": "#/components/schemas/SystemNullableOfSystemDateOnly"
              }
            ]
          },
          "czkPerEur": {
            "type": "number",
            "description": "Czech koruna per euro, the rate the app converts euro amounts with",
            "format": "double"
          },
          "rateDate": {
            "description": "The day the koruna rate is for",
            "$ref": "#/components/schemas/SystemDateOnly"
          }
        },
        "description": "A page of the account's transactions, whether older ones are kept, and the koruna rate with its date"
      },
      "RevolutReaderApiAccountTransactionResponse": {
        "required": [
          "date",
          "amount",
          "currency",
          "pending",
          "counterparty",
          "details",
          "kind"
        ],
        "type": "object",
        "properties": {
          "date": {
            "description": "The day the transaction is dated by",
            "$ref": "#/components/schemas/SystemDateOnly"
          },
          "amount": {
            "type": "number",
            "description": "Negative for money spent, positive for money received",
            "format": "double"
          },
          "currency": {
            "type": "string",
            "description": "The amount's currency, an ISO 4217 code"
          },
          "pending": {
            "type": "boolean",
            "description": "Whether the bank has not settled the transaction yet"
          },
          "counterparty": {
            "type": [
              "null",
              "string"
            ],
            "description": "The payee of money spent, the payer of money received; null when the bank names none"
          },
          "details": {
            "description": "The bank's text, line by line, as the app shows it",
            "$ref": "#/components/schemas/SystemCollectionsGenericIReadOnlyListOfSystemString"
          },
          "kind": {
            "description": "The kind of transaction, from the bank's type code",
            "$ref": "#/components/schemas/RevolutReaderApiAccountTransactionKind"
          }
        },
        "description": "A transaction as the app shows it"
      },
      "RevolutReaderApiSignInMeResponse": {
        "required": [
          "name",
          "email"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The user's name, as their Microsoft account gives it"
          },
          "email": {
            "type": "string",
            "description": "The user's email address, as their Microsoft account gives it"
          }
        },
        "description": "The signed-in user's name and email address"
      },
      "RevolutReaderApiSignInRefusedProblem": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ],
            "description": "The refused account's own email address; missing when the account has none"
          }
        },
        "description": "A problem description that refuses a signed-in account, naming its own email address"
      },
      "SystemCollectionsGenericIReadOnlyListOfRevolutReaderApiAccountTransactionResponse": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/RevolutReaderApiAccountTransactionResponse"
        }
      },
      "SystemCollectionsGenericIReadOnlyListOfSystemString": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "SystemDateOnly": {
        "type": "string",
        "format": "date"
      },
      "SystemNullableOfSystemDateOnly": {
        "type": "string",
        "format": "date"
      }
    }
  }
}
