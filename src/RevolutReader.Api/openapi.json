{
  "openapi": "3.2.0",
  "info": {
    "title": "RevolutReader.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/auth/login": {
      "get": {
        "tags": [
          "Api"
        ],
        "summary": "Starts the sign-in at Microsoft",
        "operationId": "RevolutReaderApiSignInLoginEndpoint",
        "parameters": [
          {
            "name": "anotherAccount",
            "in": "query",
            "description": "Asks Microsoft to show its account picker",
            "schema": {
              "type": [
                "null",
                "boolean"
              ]
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Found"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Api"
        ],
        "summary": "Ends the sign-in on this device",
        "operationId": "RevolutReaderApiSignInLogoutEndpoint",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/balance": {
      "get": {
        "tags": [
          "Api"
        ],
        "summary": "The account's balance, read at the bank",
        "operationId": "RevolutReaderApiAccountBalanceEndpoint",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiAccountBalanceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiSignInRefusedProblem"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiAccountBankProblem"
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiAccountBankProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "Api"
        ],
        "summary": "Who is signed in",
        "operationId": "RevolutReaderApiSignInMeEndpoint",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiSignInMeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiSignInRefusedProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/push/key": {
      "get": {
        "tags": [
          "Api"
        ],
        "summary": "The public push key the app subscribes with",
        "operationId": "RevolutReaderApiPushPushKeyEndpoint",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiPushPushKeyResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiSignInRefusedProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/push/subscription": {
      "put": {
        "tags": [
          "Api"
        ],
        "summary": "Registers this device for push notifications under the signed-in account",
        "operationId": "RevolutReaderApiPushSubscriptionEndpoint",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevolutReaderApiPushSubscriptionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiSignInRefusedProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/transactions": {
      "get": {
        "tags": [
          "Api"
        ],
        "summary": "The newest transactions, read at the bank, with the koruna rate",
        "operationId": "RevolutReaderApiAccountNewestTransactionsEndpoint",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiAccountTransactionPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiSignInRefusedProblem"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiAccountBankProblem"
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiAccountBankProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/transactions/older": {
      "get": {
        "tags": [
          "Api"
        ],
        "summary": "Older transactions, from storage, in pages of whole days",
        "operationId": "RevolutReaderApiAccountOlderTransactionsEndpoint",
        "parameters": [
          {
            "name": "before",
            "in": "query",
            "description": "The day before which the page's transactions are dated, as yyyy-MM-dd: the olderBefore of the page before it",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiAccountTransactionPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiSignInRefusedProblem"
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "The app is running",
        "operationId": "RevolutReaderApiHealthHealthEndpoint",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MicrosoftAspNetCoreMvcProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RevolutReaderApiAccountBalanceResponse": {
        "required": [
          "amount",
          "readAt",
          "czkPerEur"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "The account's available balance in euros, as the bank gives it",
            "format": "double"
          },
          "readAt": {
            "type": "string",
            "description": "When the server read the balance at the bank",
            "format": "date-time"
          },
          "czkPerEur": {
            "type": "number",
            "description": "Czech koruna per euro, the rate the app converts the balance with",
            "format": "double"
          }
        },
        "description": "The account's balance in euros, when the server read it, and the koruna rate"
      },
      "RevolutReaderApiAccountBankProblem": {
        "required": [
          "type"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "description": "Which of the bank's expected failures this is",
            "$ref": "#/components/schemas/RevolutReaderApiAccountBankProblemType"
          }
        },
        "description": "A problem description of one of the bank's expected failures, named by its type"
      },
      "RevolutReaderApiAccountBankProblemType": {
        "enum": [
          "/problems/bank-access-expired",
          "/problems/bank-rate-limited",
          "/problems/bank-unavailable"
        ],
        "type": "string"
      },
      "RevolutReaderApiAccountTransactionKind": {
        "enum": [
          "card",
          "topup",
          "transfer",
          "atm",
          "exchange",
          "refund",
          "other"
        ],
        "type": "string"
      },
      "RevolutReaderApiAccountTransactionPageResponse": {
        "required": [
          "transactions",
          "olderBefore",
          "czkPerEur",
          "rateDate"
        ],
        "type": "object",
        "properties": {
          "transactions": {
            "description": "The page's transactions, newest day first, in the bank's order within a day",
            "$ref": "#/components/schemas/SystemCollectionsGenericIReadOnlyListOfRevolutReaderApiAccountTransactionResponse"
          },
          "olderBefore": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The day before which older transactions are kept, to ask for the next older page with; null when none are",
                "$ref": "#/components/schemas/SystemNullableOfSystemDateOnly"
              }
            ]
          },
          "czkPerEur": {
            "type": "number",
            "description": "Czech koruna per euro, the rate the app converts euro amounts with",
            "format": "double"
          },
          "rateDate": {
            "description": "The day the koruna rate is for",
            "$ref": "#/components/schemas/SystemDateOnly"
          }
        },
        "description": "A page of the account's transactions, whether older ones are kept, and the koruna rate with its date"
      },
      "RevolutReaderApiAccountTransactionResponse": {
        "required": [
          "date",
          "amount",
          "currency",
          "pending",
          "counterparty",
          "details",
          "kind"
        ],
        "type": "object",
        "properties": {
          "date": {
            "description": "The day the transaction is dated by",
            "$ref": "#/components/schemas/SystemDateOnly"
          },
          "amount": {
            "type": "number",
            "description": "Negative for money spent, positive for money received",
            "format": "double"
          },
          "currency": {
            "type": "string",
            "description": "The amount's currency, an ISO 4217 code"
          },
          "pending": {
            "type": "boolean",
            "description": "Whether the bank has not settled the transaction yet"
          },
          "counterparty": {
            "type": [
              "null",
              "string"
            ],
            "description": "The payee of money spent, the payer of money received; null when the bank names none"
          },
          "details": {
            "description": "The bank's text, line by line, as the app shows it",
            "$ref": "#/components/schemas/SystemCollectionsGenericIReadOnlyListOfSystemString"
          },
          "kind": {
            "description": "The kind of transaction, from the bank's type code",
            "$ref": "#/components/schemas/RevolutReaderApiAccountTransactionKind"
          }
        },
        "description": "A transaction as the app shows it"
      },
      "RevolutReaderApiPushPushKeyResponse": {
        "required": [
          "publicKey"
        ],
        "type": "object",
        "properties": {
          "publicKey": {
            "type": "string",
            "description": "The VAPID public key (RFC 8292): the uncompressed P-256 point, base64url without padding"
          }
        },
        "description": "The server's public push key, which the app subscribes to push notifications with"
      },
      "RevolutReaderApiPushSubscriptionKeys": {
        "type": "object",
        "properties": {
          "p256dh": {
            "type": [
              "null",
              "string"
            ],
            "description": "The device's P-256 public key, the uncompressed point (65 bytes)"
          },
          "auth": {
            "type": [
              "null",
              "string"
            ],
            "description": "The device's secret (16 bytes)"
          }
        },
        "description": "The device's keys for encrypting its pushes, each base64url without padding"
      },
      "RevolutReaderApiPushSubscriptionRequest": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": [
              "null",
              "string"
            ],
            "description": "The device's push address, at its push service"
          },
          "expirationTime": {
            "type": [
              "null",
              "number"
            ],
            "description": "When the subscription expires, as the browser gives it; not used",
            "format": "double"
          },
          "keys": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The device's keys for encrypting its pushes",
                "$ref": "#/components/schemas/RevolutReaderApiPushSubscriptionKeys"
              }
            ]
          }
        },
        "description": "A device's push subscription, as the browser's PushSubscription.toJSON() gives it"
      },
      "RevolutReaderApiSignInMeResponse": {
        "required": [
          "name",
          "email"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The user's name, as their Microsoft account gives it"
          },
          "email": {
            "type": "string",
            "description": "The user's email address, as their Microsoft account gives it"
          }
        },
        "description": "The signed-in user's name and email address"
      },
      "RevolutReaderApiSignInRefusedProblem": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ],
            "description": "The refused account's own email address; missing when the account has none"
          }
        },
        "description": "A problem description that refuses a signed-in account, naming its own email address"
      },
      "SystemCollectionsGenericIReadOnlyListOfRevolutReaderApiAccountTransactionResponse": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/RevolutReaderApiAccountTransactionResponse"
        }
      },
      "SystemCollectionsGenericIReadOnlyListOfSystemString": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "SystemDateOnly": {
        "type": "string",
        "format": "date"
      },
      "SystemNullableOfSystemDateOnly": {
        "type": "string",
        "format": "date"
      }
    }
  }
}
