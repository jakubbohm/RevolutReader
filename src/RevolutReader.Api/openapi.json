{
  "openapi": "3.2.0",
  "info": {
    "title": "RevolutReader.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/auth/login": {
      "get": {
        "tags": [
          "Api"
        ],
        "summary": "Starts the sign-in at Microsoft",
        "operationId": "RevolutReaderApiSignInLoginEndpoint",
        "responses": {
          "302": {
            "description": "Found"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Api"
        ],
        "summary": "Ends the sign-in on this device",
        "operationId": "RevolutReaderApiSignInLogoutEndpoint",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "Api"
        ],
        "summary": "Who is signed in",
        "operationId": "RevolutReaderApiSignInMeEndpoint",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiSignInMeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MicrosoftAspNetCoreMvcProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RevolutReaderApiSignInRefusedProblem"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "The app is running",
        "operationId": "RevolutReaderApiHealthHealthEndpoint",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MicrosoftAspNetCoreMvcProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RevolutReaderApiSignInMeResponse": {
        "required": [
          "name",
          "email"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The user's name, as their Microsoft account gives it"
          },
          "email": {
            "type": "string",
            "description": "The user's email address, as their Microsoft account gives it"
          }
        },
        "description": "The signed-in user's name and email address"
      },
      "RevolutReaderApiSignInRefusedProblem": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ],
            "description": "The refused account's own email address; missing when the account has none"
          }
        },
        "description": "A problem description that refuses a signed-in account, naming its own email address"
      }
    }
  }
}
