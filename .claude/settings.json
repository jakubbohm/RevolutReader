{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(openspec:*)",
      "ClaudeInChromeDomain(enablebanking.com)",
      "ClaudeInChromeDomain(tilisy-sandbox.enablebanking.com)",
      "ClaudeInChromeDomain(localhost)",
      "ClaudeInChromeDomain(localhost:5310)",
      "mcp__claude-in-chrome__tabs_create_mcp",
      "ClaudeInChromeDomain(localhost:57355)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/deny-test-edits.mjs"
            ],
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
