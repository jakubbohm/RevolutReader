# =============================================================================
# .NET / Visual Studio  (curated from `dotnet new gitignore`)
# =============================================================================

# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]64/
bld/
artifacts/
publish/
[Ll]og/
[Ll]ogs/
*.log
*.tlog
*.binlog
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.pdb
*.rsp
!Directory.Build.rsp

# Visual Studio user-specific files and cache
.vs/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.[Cc]ache
!?*.[Cc]ache/
.localhistory/
.vshistory/
ScaffoldingReadMe.txt
MigrationBackup/

# Tests and coverage (.NET)
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
BenchmarkDotNet.Artifacts/

# NuGet
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets
# NOTE: the template's `**/[Pp]ackages/*` is intentionally omitted — SDK-style
# projects don't use it, and it would swallow a JS workspace `packages/` folder.

# Publish profiles / settings (may contain credentials)
*.pubxml
*.publishproj
*.[Pp]ublish.xml
*.publishsettings
PublishScripts/
*.pfx

# ReSharper / Rider
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/
*.sln.iml

# If the SPA build output is copied into the ASP.NET host, uncomment:
# **/wwwroot/dist/

# =============================================================================
# VS Code
# =============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.code-workspace
*.lscache
.history/
*.vsix

# =============================================================================
# Azure
# =============================================================================
# Azure Developer CLI (azd) environments — contain subscription ids / secrets
.azure/
# Azure Functions local settings — contain connection strings / secrets
local.settings.json
# Azurite local storage emulator data
__azurite_db*__.json
__blobstorage__/
__queuestorage__/
# Legacy Azure publish / emulator output
*.azurePubxml
csx/
*.build.csdef
ecf/
rcf/

# =============================================================================
# Node / Vite / TypeScript / PWA
# =============================================================================
node_modules/
dist/
dist-ssr/
*.local
.env

# Package-manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Tooling caches
*.tsbuildinfo
.eslintcache
.stylelintcache
vite.config.*.timestamp-*

# vite-plugin-pwa dev service worker output
dev-dist/

# Frontend tests / coverage (Vitest, Playwright)
coverage/
*.lcov
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/

# =============================================================================
# OS / editor junk
# =============================================================================
.DS_Store
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*.swp
*~
~$*

# =============================================================================
# Local tooling
# =============================================================================
# Claude Code local (per-user) settings
.claude/settings.local.json
# codebase-memory-mcp local graph artifacts
.codebase-memory/
# Claude Code worktrees (a second checkout for parallel sessions)
.claude/worktrees/

# =============================================================================
# Secrets (docs/conventions/workflow.md § 7 — keys, tokens and bank data never get committed)
# =============================================================================
*.pem
*.key
spikes/**/secrets/
