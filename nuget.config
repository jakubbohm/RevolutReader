<?xml version="1.0" encoding="utf-8"?>
<!-- Only nuget.org, whatever sources the machine has configured globally: central package
     management requires a single mapped source (NU1507), and every package here comes from
     nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
